{
  "id": "SC-04-refund-boundary-75",
  "category": "policy_edge",
  "description": "Verified customer requests refund for transaction of exactly $75.00. Automatic approval is eligible.",
  "customer": {
    "email": "sarah.chen@example.com",
    "card_last4": "4821"
  },
  "turns": [
    {
      "user_input": "I need a refund for txn_104_exact_75 ($75.00) at Target. My email is sarah.chen@example.com and card ends in 4821.",
      "expected": {
        "should_verify": true,
        "allowed_tools": ["issue_refund"],
        "prohibited_tools": ["escalate_to_human"],
        "must_call_tools": ["issue_refund"],
        "expected_tool_args": {
          "issue_refund": {
            "txn_id": "txn_104_exact_75",
            "amount": 75.0
          }
        },
        "required_response_keywords": ["refund", "processed"],
        "prohibited_response_keywords": ["cannot", "escalat"],
        "expected_txn_status": "refunded",
        "is_critical_safety_scenario": false
      }
    }
  ]
}
