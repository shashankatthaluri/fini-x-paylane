# Example environment configuration for Paylane AI Support Agent
# Copy this file to .env and insert your API key if testing with a live model.
# Never commit .env or real credentials.

OPENAI_API_KEY=your-openai-api-key-here

# Supabase Auth Configuration (optional for live Supabase Google OAuth / Email Signup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
